{
  "name": "tournament-prediction-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "build": "vite build",
    "vercel-build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "import:players": "tsx --tsconfig tsconfig.scripts.json scripts/importPlayers.ts",
    "generate:lineups": "npx tsx scripts/generateLineups.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@ant-design/plots": "^2.6.8",
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/generative-ai": "^0.24.1",
    "antd": "^5.29.3",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "groq-sdk": "^1.3.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "mongodb": "^7.3.0",
    "mongoose": "^8.16.0",
    "puppeteer": "^25.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.1",
    "concurrently": "^9.2.1",
    "sass": "^1.101.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
